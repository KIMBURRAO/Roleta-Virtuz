# URL do projeto em Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Prefira a publishable key atual. A anon key legada também é aceita por compatibilidade.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
# VITE_SUPABASE_ANON_KEY=eyJ...

# Nunca coloque service_role ou secret key em variáveis VITE_*.
